msgid "Kangaroo"
msgstr "Cangaru"

#: activities/explore_world_animals/resource/board/board2.qml:53
#, fuzzy
#| msgctxt "board2|"
#| msgid ""
#| "Kangaroo lives in Australia and is well-known for pouch on its belly used "

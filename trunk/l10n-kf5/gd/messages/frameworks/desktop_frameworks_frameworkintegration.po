#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "Plasma Workspace"
msgstr "Rum-obrach Plasma"

#: plasma_workspace.notifyrc:42
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "An sgudal: falamh"

#: plasma_workspace.notifyrc:79
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "Chaidh an sgudal fhalamhachadh"

#: plasma_workspace.notifyrc:120
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr "Coileanadh teacsa: cuairteachadh"

#: plasma_workspace.notifyrc:156
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "Ràinig thu an deireadh de na tha de sheisean ann"

#: plasma_workspace.notifyrc:196
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "Coileanadh teacsa: cha do lorg sinn gin"

#: plasma_workspace.notifyrc:232
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Cha deach coileanadh a fhreagras a lorg"

#: plasma_workspace.notifyrc:272
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Coileanadh teacsa: pàirt dheth co-ionnann"

#: plasma_workspace.notifyrc:308
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Lorg sinn barrachd air aon nì a fhreagradh"

#: plasma_workspace.notifyrc:348
msgctxt "Name"
msgid "Fatal Error"
msgstr "Mearachd mharbhtach"

#: plasma_workspace.notifyrc:384
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Chaidh am prògram fhàgail ri linn mearachd dona"

#: plasma_workspace.notifyrc:425
msgctxt "Name"
msgid "Notification"
msgstr "Brath"

#: plasma_workspace.notifyrc:462
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Thachair rudeigin sònraichte sa phrògram"

#: plasma_workspace.notifyrc:502
msgctxt "Name"
msgid "Warning"
msgstr "Rabhadh"

#: plasma_workspace.notifyrc:539
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Bha mearachd sa phrògram a dh'adhbharaicheas trioblaid ma dh'fhaoidte"

#: plasma_workspace.notifyrc:579
msgctxt "Name"
msgid "Catastrophe"
msgstr "Tubaist"

#: plasma_workspace.notifyrc:615
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr ""
"Thachair mearachd glè dhona agus chaidh am prògram fhàgail air a char as "
"lugha"

#: plasma_workspace.notifyrc:656
msgctxt "Name"
msgid "Login"
msgstr "Logadh a-steach"

#: plasma_workspace.notifyrc:693
msgctxt "Comment"
msgid "A new session is starting"
msgstr "Tha seisean ùr a' tòiseachadh"

#: plasma_workspace.notifyrc:733
msgctxt "Name"
msgid "Logout"
msgstr "Logadh a-mach"

#: plasma_workspace.notifyrc:770
msgctxt "Comment"
msgid "Session is exiting"
msgstr "Tha an seisean 'ga fhàgail"

#: plasma_workspace.notifyrc:811
msgctxt "Name"
msgid "Logout Canceled"
msgstr "Chaidh sgur dhen logadh a-mach"

#: plasma_workspace.notifyrc:848
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Chaidh sgur dhen logadh a-mach à Plasma"

#: plasma_workspace.notifyrc:888
msgctxt "Name"
msgid "Print Error"
msgstr "Mearachd clò-bhualaidh"

#: plasma_workspace.notifyrc:925
msgctxt "Comment"
msgid "A print error has occurred"
msgstr "Thachair mearachd leis a' chlò-bhualadh"

#: plasma_workspace.notifyrc:965
msgctxt "Name"
msgid "Information Message"
msgstr "Teachdaireachd fiosrachaidh"

#: plasma_workspace.notifyrc:1002
msgctxt "Comment"
msgid "An information message is being shown"
msgstr "Tha teachdaireachd fiosrachaidh 'ga sealltainn"

#: plasma_workspace.notifyrc:1042
msgctxt "Name"
msgid "Warning Message"
msgstr "Teachdaireachd rabhaidh"

#: plasma_workspace.notifyrc:1079
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "Tha teachdaireachd rabhaidh 'ga sealltainn"

#: plasma_workspace.notifyrc:1119
msgctxt "Name"
msgid "Critical Message"
msgstr "Teachdaireachd èiginneach"

#: plasma_workspace.notifyrc:1156
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "Tha teachdaireachd èiginneach 'ga sealltainn"

#: plasma_workspace.notifyrc:1196
msgctxt "Name"
msgid "Question"
msgstr "Ceist"

#: plasma_workspace.notifyrc:1233
msgctxt "Comment"
msgid "A question is being asked"
msgstr "Tha ceist 'ga fhaighneachd"

#: plasma_workspace.notifyrc:1274
msgctxt "Name"
msgid "Beep"
msgstr "Bìd"

#: plasma_workspace.notifyrc:1311
msgctxt "Comment"
msgid "Sound bell"
msgstr "Fuaim cluig"

#: plasma_workspace.notifyrc:1351
msgctxt "Name"
msgid "Widget deleted"
msgstr ""

#: plasma_workspace.notifyrc:1379
#, fuzzy
#| msgctxt "Comment"

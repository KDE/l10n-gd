#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "Plasma Workspace"
msgstr "Rum-obrach Plasma"

#: plasma_workspace.notifyrc:58
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "An sgudal: falamh"

#: plasma_workspace.notifyrc:111
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "Chaidh an sgudal fhalamhachadh"

#: plasma_workspace.notifyrc:168
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr "Coileanadh teacsa: cuairteachadh"

#: plasma_workspace.notifyrc:220
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "Ràinig thu an deireadh de na tha de sheisean ann"

#: plasma_workspace.notifyrc:276
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "Coileanadh teacsa: cha do lorg sinn gin"

#: plasma_workspace.notifyrc:328
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Cha deach coileanadh a fhreagras a lorg"

#: plasma_workspace.notifyrc:384
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Coileanadh teacsa: pàirt dheth co-ionnann"

#: plasma_workspace.notifyrc:436
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Lorg sinn barrachd air aon nì a fhreagradh"

#: plasma_workspace.notifyrc:493
msgctxt "Name"
msgid "Fatal Error"
msgstr "Mearachd mharbhtach"

#: plasma_workspace.notifyrc:547
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Chaidh am prògram fhàgail ri linn mearachd dona"

#: plasma_workspace.notifyrc:604
msgctxt "Name"
msgid "Notification"
msgstr "Brath"

#: plasma_workspace.notifyrc:658
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Thachair rudeigin sònraichte sa phrògram"

#: plasma_workspace.notifyrc:714
msgctxt "Name"
msgid "Warning"
msgstr "Rabhadh"

#: plasma_workspace.notifyrc:768
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Bha mearachd sa phrògram a dh'adhbharaicheas trioblaid ma dh'fhaoidte"

#: plasma_workspace.notifyrc:825
msgctxt "Name"
msgid "Catastrophe"
msgstr "Tubaist"

#: plasma_workspace.notifyrc:878
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr ""
"Thachair mearachd glè dhona agus chaidh am prògram fhàgail air a char as "
"lugha"

#: plasma_workspace.notifyrc:934
msgctxt "Name"
msgid "Application Crash"
msgstr "Thuislich aplacaid"

#: plasma_workspace.notifyrc:984
msgctxt "Comment"
msgid "An application just closed unexpectedly"
msgstr "Tha aplacaid air a dùnadh gun dùil"

#: plasma_workspace.notifyrc:1036
msgctxt "Name"
msgid "Login"
msgstr "Logadh a-steach"

#: plasma_workspace.notifyrc:1089
msgctxt "Comment"
msgid "A new session is starting"
msgstr "Tha seisean ùr a' tòiseachadh"

#: plasma_workspace.notifyrc:1145
msgctxt "Name"
msgid "Logout"
msgstr "Logadh a-mach"

#: plasma_workspace.notifyrc:1198
msgctxt "Comment"
msgid "Session is exiting"
msgstr "Tha an seisean 'ga fhàgail"

#: plasma_workspace.notifyrc:1255
msgctxt "Name"
msgid "Logout Canceled"
msgstr "Chaidh sgur dhen logadh a-mach"

#: plasma_workspace.notifyrc:1308
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Chaidh sgur dhen logadh a-mach à Plasma"

#: plasma_workspace.notifyrc:1364
msgctxt "Name"
msgid "Print Error"
msgstr "Mearachd clò-bhualaidh"

#: plasma_workspace.notifyrc:1418
msgctxt "Comment"
msgid "A print error has occurred"
msgstr "Thachair mearachd leis a' chlò-bhualadh"

#: plasma_workspace.notifyrc:1475
msgctxt "Name"
msgid "Information Message"
msgstr "Teachdaireachd fiosrachaidh"

#: plasma_workspace.notifyrc:1529
msgctxt "Comment"
msgid "An information message is being shown"
msgstr "Tha teachdaireachd fiosrachaidh 'ga sealltainn"

#: plasma_workspace.notifyrc:1586
msgctxt "Name"
msgid "Warning Message"
msgstr "Teachdaireachd rabhaidh"

#: plasma_workspace.notifyrc:1640
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "Tha teachdaireachd rabhaidh 'ga sealltainn"

#: plasma_workspace.notifyrc:1697
msgctxt "Name"
msgid "Critical Message"
msgstr "Teachdaireachd èiginneach"

#: plasma_workspace.notifyrc:1751
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "Tha teachdaireachd èiginneach 'ga sealltainn"

#: plasma_workspace.notifyrc:1808
msgctxt "Name"
msgid "Question"
msgstr "Ceist"

#: plasma_workspace.notifyrc:1862
msgctxt "Comment"
msgid "A question is being asked"
msgstr "Tha ceist 'ga fhaighneachd"

#: plasma_workspace.notifyrc:1920
msgctxt "Name"
msgid "Beep"
msgstr "Bìd"

#: plasma_workspace.notifyrc:1973
msgctxt "Comment"
msgid "Sound bell"
msgstr "Fuaim cluig"

#: plasma_workspace.notifyrc:2029
msgctxt "Name"
msgid "Widget failed to install"
msgstr "Cha deach le stàladh a' widget"

#: plasma_workspace.notifyrc:2079
msgctxt "Comment"
msgid "A widget could not be installed"
msgstr "Cha b' urrainn dhuinn a' widget a stàladh"

#: plasma_workspace.notifyrc:2132
msgctxt "Name"
msgid "Widget deleted"
msgstr "Chaidh widget a sguabadh às"

#: plasma_workspace.notifyrc:2184
msgctxt "Comment"
msgid "A widget has been deleted"
msgstr "Chaidh widget a sguabadh às"

#: plasma_workspace.notifyrc:2239
msgctxt "Name"
msgid "Device plugged in"
msgstr ""

#: plasma_workspace.notifyrc:2277
msgctxt "Comment"
msgid "A device was plugged in"
msgstr ""

#: plasma_workspace.notifyrc:2319
msgctxt "Name"
msgid "Device unplugged"
msgstr ""

#: plasma_workspace.notifyrc:2357
msgctxt "Comment"
msgid "A device was unplugged"
msgstr ""
